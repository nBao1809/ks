DJANGO_SETTINGS_MODULE=hotel_backend.settings.production
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DB_NAME=smart_hotel
DB_USER=root
DB_PASSWORD=1234
DB_HOST=
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret


EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-16-chars
DEFAULT_FROM_EMAIL=Smart Hotel <noreply@smarthotel.vn>

# VNPay sandbox (đăng ký IPN URL trên Merchant Admin: VNPAY_IPN_URL)
BACKEND_BASE_URL=http://127.0.0.1:8000
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/api/v1/payments/vnpay/return/
VNPAY_IPN_URL=http://127.0.0.1:8000/api/v1/payments/vnpay/ipn/

# Cloudinary (https://cloudinary.com → Dashboard → Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
